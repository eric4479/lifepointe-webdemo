<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <!-- Cinematic hero video fallback (shown when video is off / slow connection) -->
  <defs>
    <linearGradient id="fallbackGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#1A1A2E"/>
      <stop offset="40%" stop-color="#16213E"/>
      <stop offset="100%" stop-color="#0F3460"/>
    </linearGradient>
  </defs>
  <!-- Gradient background -->
  <rect width="1200" height="630" fill="url(#fallbackGrad)"/>
  
  <!-- Subtle cross watermark -->
  <rect x="595" y="40" width="10" height="550" fill="#DD6B20" opacity="0.12"/>
  <rect x="420" y="260" width="360" height="10" fill="#DD6B20" opacity="0.12"/>
  
  <!-- Church silhouette -->
  <rect x="280" y="420" width="640" height="120" fill="#1A202C" opacity="0.3"/>
  <rect x="290" y="410" width="80" height="110" fill="#1A202C" opacity="0.4"/>
  <rect x="400" y="400" width="400" height="140" fill="#1A202C" opacity="0.35"/>
  
  <!-- Hero text -->
  <text x="600" y="160" text-anchor="middle" font-family="Inter, sans-serif" font-size="44" font-weight="700" fill="#FFFFFF" letter-spacing="2">
    LIFE<span style="fill:#DD6B20">POINTE</span>
  </text>
  <text x="600" y="200" text-anchor="middle" font-family="Georgia, serif" font-size="36" font-style="italic" fill="#FFFFFF" opacity="0.92">
    Ministries
  </text>
  <text x="600" y="255" text-anchor="middle" font-family="Georgia, serif" font-size="24" font-style="italic" fill="#FFFFFF" opacity="0.7">
    Love in Action
  </text>
  
  <!-- Description -->
  <text x="600" y="320" text-anchor="middle" font-family="Inter, sans-serif" font-size="20" fill="#FFFFFF" opacity="0.85">
    A church in Titusville, FL sharing the love of Christ
  </text>
  <text x="600" y="350" text-anchor="middle" font-family="Inter, sans-serif" font-size="20" fill="#FFFFFF" opacity="0.85">
    through worship, community outreach, and practical service.
  </text>
  
  <!-- Service times box -->
  <rect x="180" y="385" width="840" height="70" rx="10" fill="#FFFFFF" opacity="0.08" stroke="#FFFFFF" stroke-opacity="0.15"/>
  <text x="600" y="415" text-anchor="middle" font-family="Inter, sans-serif" font-size="18" font-weight="600" fill="#FFFFFF">Sunday Worship — Doors 10:00 AM &middot; Service 10:30 AM</text>
  <text x="600" y="440" text-anchor="middle" font-family="Inter, sans-serif" font-size="15" fill="#FFFFFF" opacity="0.75">Titusville Civic Center &middot; 4220 S. Hopkins Ave</text>
  
  <!-- Footer -->
  <text x="600" y="595" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" fill="#FFFFFF" opacity="0.4">
    lifepointeministries@gmail.com &middot; 321-383-0254 &middot; You're welcome here
  </text>
</svg>
